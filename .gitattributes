# Auto-detect text files and normalize line endings
* text=auto

# Python and shell files - LF
*.py text eol=lf
*.sh text eol=lf

# JSON and YAML - LF
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Markdown - LF
*.md text eol=lf

# Windows batch files - CRLF
*.bat text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg binary
*.zip binary

# BEGIN release.py [publish]
# Generated by release.py from the [publish] section of release.ini.
# Do not make edits below this line: everything down to the END line is overwritten.
* export-ignore
/LICENSE* -export-ignore
/gitinit-*.py -export-ignore
/gitinit-*.py/** -export-ignore
/release.py -export-ignore
# END release.py [publish]
